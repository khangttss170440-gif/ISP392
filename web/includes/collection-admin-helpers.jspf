<%@page pageEncoding="UTF-8"%>
<%!
private String caEscape(Object value){return value==null?"":value.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String caColor(String value){return java.net.URLEncoder.encode(value,java.nio.charset.StandardCharsets.UTF_8);}
private String caRole(model.OutfitItem.Role role){
    switch(role){case TOP:return "Áo";case BOTTOM:return "Quần";case LAYER:return "Áo khoác";case SHOES:return "Giày";case ACCESSORY:return "Phụ kiện";default:return "Chọn vai trò";}
}
private String caStyle(String id){for(service.OutfitRecommendationService.Style style:service.OutfitRecommendationService.Style.values())if(style.getId().equals(id))return style.getLabel();return "";}
%>
