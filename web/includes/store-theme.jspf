<%@page pageEncoding="UTF-8"%>
<style>
:root{--ink:#211c18;--muted:#7d746b;--cream:#f6f3ed;--paper:#fff;--line:#ded7cc;--green:#7b5a35;--lime:#c5a66b;--orange:#b18a50;--radius:0;--shadow:none;--gold:#b99a60;--brown:#33271f}
body{background:#fff;color:var(--ink);font-family:Arial,"Segoe UI",sans-serif;line-height:1.6}
.shell{width:min(1320px,calc(100% - 96px))}.announcement{background:#211b17;color:#e8d7b7;font-size:10px;letter-spacing:.21em;padding:10px 20px;text-align:center}
.topbar{position:relative;z-index:30;border-bottom:1px solid #e7e2da;background:#fff}.nav{height:102px;gap:34px}.brand{font:500 29px/1.1 Arial,sans-serif;letter-spacing:.16em;white-space:nowrap}.brand-caption{display:block;font-size:7px;letter-spacing:.23em;margin-top:9px;color:#8d7960}.brand i{color:inherit}.navlinks{gap:30px;color:var(--ink);font-size:11px;letter-spacing:.1em;text-transform:uppercase}.navlinks a{padding:14px 0;position:relative;white-space:nowrap}.navlinks a:after{content:"";height:1px;background:var(--gold);position:absolute;bottom:7px;left:0;right:100%;transition:right .2s}.navlinks a:hover:after{right:0}.nav-actions{gap:23px;flex-shrink:0;font-size:12px}.login-link{font-size:11px;text-transform:uppercase;letter-spacing:.08em}.login-link span{padding-left:7px}.nav-icon{background:transparent;border-radius:0;width:28px;height:32px}.nav-icon svg{width:24px;height:24px}.nav a:hover{color:#8a6739}
.account-dropdown{position:relative}.account-dropdown summary{display:flex;align-items:center;gap:9px;list-style:none;cursor:pointer;min-height:44px}.account-dropdown summary::-webkit-details-marker{display:none}.avatar-icon{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--line);border-radius:50%;background:#f7f3ed}.avatar-icon svg{width:22px;height:22px}.account-name{max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.account-chevron{width:13px;height:13px;transition:transform .2s}.account-dropdown[open] .account-chevron{transform:rotate(180deg)}.account-panel{position:absolute;top:calc(100% + 16px);right:0;width:280px;background:#fff;border:1px solid var(--line);box-shadow:0 14px 35px #211b1715;padding:8px 18px 10px;z-index:50}.account-panel-title{padding:14px 4px 16px;border-bottom:1px solid var(--line);margin-bottom:4px}.account-panel-title small{display:block;font-size:9px;color:#8d7960;letter-spacing:.15em}.account-panel-title strong{display:block;font-size:14px;font-weight:500;margin-top:4px;overflow-wrap:anywhere}.account-panel>a,.account-panel button{display:flex;align-items:center;justify-content:space-between;width:100%;padding:13px 4px;font:13px Arial,sans-serif;color:var(--ink);background:none;border:0;text-align:left;cursor:pointer}.account-panel>a:hover,.account-panel button:hover{color:#8a6739;background:#f9f6f0}.account-panel form{margin:4px 0 0;border-top:1px solid var(--line)}
.button{border-radius:0;background:#211c18;border:1px solid #211c18;padding:15px 25px;font:600 11px/1.5 Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;min-height:46px}.button:hover{background:#7b5a35;border-color:#7b5a35;transform:none}.button.light{border-color:#fff}.button.line{border-color:#c6baaa}.button.small{font-size:10px;padding:11px 17px;min-height:38px}.eyebrow{font-size:10px;font-weight:500;letter-spacing:.27em;color:#8b683d}.eyebrow:before{display:none}.page-title,.section-head h2{font-family:Arial,sans-serif;font-weight:400;letter-spacing:-.025em}.page-title{font-size:clamp(35px,4vw,52px)}.page{padding:52px 0 90px}.page-intro{font-size:14px}.breadcrumb{font-size:11px;margin-bottom:28px}.section{padding:80px 0}.section-head{margin-bottom:35px}.section-head h2{font-size:42px;margin:10px 0 0}.text-link{font-weight:400}.text-link:hover{color:#8b683d}.field,.select,.textarea,.qty{border-radius:0;border-color:#d9d2c9}.field,.select,.textarea{padding:13px 14px}.field:focus,.select:focus,.textarea:focus{border-color:#8a6739;box-shadow:0 0 0 2px #b99a601a}.form-label{font-size:12px;font-weight:500}.alert{border-radius:0}.alert.success{background:#f3efe3;color:#65502e}.filter-box,.product-card,.product-art,.detail-art,.cart-list,.summary,.review,.empty-state,.promotion-card,.promotion-code,.account-hero,.account-cell,.account-shortcut{border-radius:0;box-shadow:none}.filter-link{border-radius:0}.filter-link:hover,.filter-link.active{background:#f2ece1;color:#76552d}.product-card{border:0;background:#fff}.product-card:hover{transform:none;box-shadow:none}.product-info{padding:19px 0 23px}.product-name{font-size:16px;font-weight:500}.product-tag{border-radius:0;font-size:9px;letter-spacing:.12em}.product-art{height:300px;background:linear-gradient(140deg,#e9e5df,#bcb4a8)}.product-card:nth-child(3n+2) .product-art{background:linear-gradient(140deg,#ddd4c8,#9e8973)}.product-card:nth-child(3n) .product-art{background:linear-gradient(140deg,#e8e6e0,#afa89d)}.product-art:before{background:linear-gradient(110deg,#ffffff3a,#00000021),linear-gradient(155deg,#8e8171,#3a3027)}.detail-art{background:linear-gradient(140deg,#e8e2d8,#b5a48e)}.detail-art:before{background:linear-gradient(110deg,#fff5,#0002),linear-gradient(160deg,#87705a,#302820)}.detail-copy h1{font-family:Arial,sans-serif;font-weight:400}.summary-row{color:#7d746b}.summary{top:22px}.cart-thumb{border-radius:0;background:linear-gradient(145deg,#e3dcd0,#b1a18c)}.cart-thumb:after{background:linear-gradient(120deg,#fff5,#0002),linear-gradient(160deg,#8b745b,#382e24)}.promotion-card h2{font-family:Arial,sans-serif;font-weight:400;color:#7b5a35}.promotion-card h3{font-weight:500}.promotion-code{background:#f7f3e9;border-color:#b69b71}.account-hero{background:#33271f}.account-hero p{color:#ded2c2}.account-shortcut:hover{border-color:#b99a60}.auth-wrap{border-radius:0;box-shadow:none;border-color:var(--line)}.auth-aside{background:#33271f}.auth-aside p{color:#e1d5c5}.auth-aside h2{font-family:Arial,sans-serif;font-weight:400}.auth-form h1{font-family:Arial,sans-serif;font-weight:400;font-size:38px}
.editorial-hero{min-height:650px;height:calc(100svh - 143px);max-height:900px;background:#302a24 url('<%=request.getContextPath()%>/assets/images/mensform-hero.webp') center top/cover no-repeat;position:relative;display:flex;align-items:center;color:#fff}.editorial-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#191512d9 0%,#1915128f 37%,#19151215 75%)}.editorial-hero .shell{position:relative;padding-top:30px;padding-bottom:70px}.editorial-hero .eyebrow{color:#ddbd80}.editorial-hero h1{font:400 clamp(48px,5.8vw,90px)/1.08 Arial,sans-serif;letter-spacing:-.03em;margin:27px 0;max-width:760px}.editorial-hero p{font-size:15px;max-width:430px;color:#e8e0d8;line-height:1.9;margin:0 0 34px}.editorial-hero .button{min-width:210px}.hero-index{white-space:nowrap;position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;gap:10px;align-items:center;color:#ded2bd;font-size:9px;letter-spacing:.2em}.hero-index span{width:75px;height:1px;background:#b99a60}.editorial-intro{text-align:center;max-width:680px;margin:0 auto 45px}.editorial-intro h2{font:400 clamp(30px,4vw,49px)/1.2 Arial,sans-serif;letter-spacing:-.025em;margin:14px 0}.editorial-intro p{color:var(--muted);font-size:14px}.wardrobe-section{background:#f6f3ed;padding:90px 0}.wardrobe-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.wardrobe-card{position:relative;overflow:hidden;min-height:400px;display:flex;flex-direction:column;justify-content:flex-end;padding:30px;color:#fff;background:#504338}.wardrobe-card:before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#211b17d9,#211b1710 60%),url('<%=request.getContextPath()%>/assets/images/mens-belt.png') center 30%/cover;transition:transform .6s}.wardrobe-card:nth-child(2):before{background-image:linear-gradient(0deg,#211b17d9,#211b1710 60%),url('https://images.unsplash.com/photo-1627123424574-724758594e93?auto=format&fit=crop&w=700&q=85');background-position:center;filter:sepia(.15)}.wardrobe-card:nth-child(3):before{background-image:linear-gradient(0deg,#211b17d9,#211b1710 60%),url('https://images.unsplash.com/photo-1523170335258-f5ed11844a49?auto=format&fit=crop&w=700&q=85');background-position:center;filter:grayscale(.3)}.wardrobe-card:hover:before{transform:scale(1.04)}.wardrobe-card>*{position:relative}.wardrobe-card small{letter-spacing:.2em;font-size:9px;color:#dac8ad}.wardrobe-card h3{font:400 30px Arial,sans-serif;margin:9px 0 20px}.wardrobe-card .wardrobe-link{font-size:10px;letter-spacing:.13em;text-transform:uppercase;border-bottom:1px solid #ffffff70;width:fit-content;padding-bottom:5px}
.editorial-offer{background:#eae3d7;padding:44px 0}.editorial-offer .shell{display:flex;align-items:center;justify-content:space-between;gap:35px}.editorial-offer h2{font:400 31px Arial,sans-serif;margin:9px 0}.editorial-offer p{color:#776652;font-size:13px;margin:0}.editorial-offer .button{background:transparent;border-color:#8e7754;color:#3b2d1f;flex-shrink:0}.editorial-offer .button:hover{background:#d9cbb5}.collection-story{display:grid;grid-template-columns:1fr 1fr;min-height:650px;background:#33271f;color:#fff;scroll-margin-top:20px}.collection-image{background:#504338 url('https://thegioida.vn/wp-content/uploads/2025/03/sku-1-Black-lightweight.jpg') 60% center/cover;min-height:560px}.collection-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:70px clamp(35px,6vw,100px)}.collection-copy .eyebrow{color:#d4b477}.collection-copy h2{font:400 clamp(38px,4vw,64px)/1.14 Arial,sans-serif;letter-spacing:-.02em;margin:25px 0}.collection-copy p{color:#d6c7b5;font-size:14px;line-height:1.9;max-width:420px;margin:0 0 35px}.collection-copy .button{background:#b99a60;color:#211b17;border-color:#b99a60}.collection-copy .button:hover{background:#cdb786}.store-values{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;text-align:center;padding:45px 0}.store-values b{display:block;font-size:11px;letter-spacing:.13em;font-weight:500}.store-values p{margin:8px 0 0;color:var(--muted);font-size:12px}
.footer{background:#211b17;padding:65px 0 0;color:#ede6db}.footer-inner{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:65px;align-items:start}.footer .brand{font-size:26px}.footer .brand-caption{color:#b7a487}.footer h2{font:500 11px Arial,sans-serif;color:#cbb07c;letter-spacing:.15em;margin:0 0 22px}.footer p{font-size:12px;color:#b9ac9a;max-width:380px;line-height:1.9;margin-top:20px}.footer-links{display:grid;gap:10px;font-size:12px;color:#c7bbaa}.footer a:hover{color:#e5c791}.footer-bottom{border-top:1px solid #ffffff20;padding:21px 0;margin-top:50px;font-size:10px;color:#9f907b;letter-spacing:.07em;display:flex;justify-content:space-between;gap:20px}
.login-page{padding:0;background:#fff}.login-layout{display:grid;grid-template-columns:1fr 1fr;min-height:720px}.login-form-panel{padding:75px clamp(30px,7vw,110px);max-width:740px;width:100%;margin:0 auto}.login-form-panel .eyebrow{margin-bottom:18px}.login-form-panel h1{font:400 47px/1.15 Arial,sans-serif;letter-spacing:-.025em;margin:0 0 15px}.login-form-panel>p{font-size:14px;color:#817568;margin:0 0 32px}.login-form-panel .form-label{margin-top:22px}.login-form-panel .button{width:100%;margin-top:30px;background:#8b6940;border-color:#8b6940}.login-form-panel .button:hover{background:#33271f}.login-register{margin:25px 0 0;text-align:center;font-size:12px;color:var(--muted)}.login-register a{color:#896637;border-bottom:1px solid #bea16d;padding-bottom:3px}.login-image{display:flex;flex-direction:column;justify-content:flex-end;padding:65px;background:linear-gradient(0deg,#211b17db,#211b1700 80%),url('https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=1200&q=85') center/cover;color:#fff}.login-image .eyebrow{color:#d4b477}.login-image h2{font:400 48px/1.15 Arial,sans-serif;margin:20px 0}.login-image p{font-size:13px;max-width:340px;color:#e3d6c3}.login-home{display:inline-block;margin-top:25px;font-size:11px;color:#8b7b67}.login-form-panel .alert{font-size:13px}
a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid #b99a60;outline-offset:5px}.button:disabled{opacity:.5;cursor:not-allowed}
@media(max-width:1100px){.shell{width:calc(100% - 64px)}.nav{gap:22px}.navlinks{gap:18px}.nav-actions{gap:15px}.brand{font-size:24px}.account-name{max-width:110px}.collection-copy{padding:50px 35px}.editorial-hero{min-height:600px}.wardrobe-card{min-height:330px}}
@media(max-width:900px){.nav{height:auto;min-height:100px;flex-wrap:wrap;padding:22px 0 0;gap:18px}.navlinks{order:3;width:100%;justify-content:center;border-top:1px solid var(--line);gap:32px}.nav-actions{margin-left:auto;flex:initial;flex-wrap:nowrap}.editorial-hero{height:650px;min-height:0}.editorial-hero h1{font-size:64px}.wardrobe-grid{gap:15px}.wardrobe-card{padding:20px;min-height:310px}.wardrobe-card h3{font-size:25px}.collection-story{min-height:550px}.collection-image{min-height:550px}.footer-inner{gap:35px}.login-form-panel{padding:55px 30px}.login-image{padding:35px}.login-image h2{font-size:38px}}
@media(max-width:680px){.shell{width:calc(100% - 36px)}.announcement{font-size:8px;letter-spacing:.11em;padding:9px 10px}.nav{min-height:90px;padding-top:18px;gap:15px}.brand{font-size:21px}.brand-caption{font-size:6px;margin-top:6px}.navlinks{display:flex;gap:0;justify-content:space-between;overflow:auto;font-size:9px;letter-spacing:.04em}.navlinks a{padding:13px 0}.nav-actions{gap:12px}.account-name{max-width:70px;font-size:11px}.avatar-icon{width:28px;height:28px}.account-dropdown summary{gap:6px}.account-chevron{width:10px}.account-panel{right:-35px;top:calc(100% + 10px);width:min(280px,calc(100vw - 36px))}.login-link{font-size:9px;letter-spacing:0}.shopping-bag{width:22px}.shopping-bag svg{width:21px}.editorial-hero{height:auto;min-height:760px;background-position:72% top;background-size:auto 520px}.editorial-hero:before{background:linear-gradient(180deg,#19151205 0%,#302a2450 30%,#302a24 63%)}.editorial-hero .shell{padding:340px 0 85px}.editorial-hero h1{font-size:49px;max-width:350px;margin:22px 0}.editorial-hero p{font-size:13px;max-width:280px}.editorial-hero .eyebrow{font-size:9px;letter-spacing:.21em}.wardrobe-section{padding:55px 0}.editorial-intro{margin-bottom:30px}.editorial-intro p{font-size:12px}.wardrobe-grid{grid-template-columns:1fr;gap:15px}.wardrobe-card{min-height:340px;padding:26px}.wardrobe-card:before{background-position:center 40%}.editorial-offer{padding:32px 0}.editorial-offer .shell{align-items:flex-start;flex-direction:column;gap:22px}.editorial-offer h2{font-size:28px}.collection-story{grid-template-columns:1fr}.collection-image{min-height:420px;background-position:60% 35%}.collection-copy{padding:45px 25px 50px}.collection-copy h2{font-size:42px}.store-values{grid-template-columns:1fr;gap:25px;padding:35px 0}.store-values>div+div{border-top:1px solid var(--line);padding-top:23px}.footer{padding:45px 0 0}.footer-inner{grid-template-columns:1fr 1fr;gap:35px 25px}.footer-intro{grid-column:1/-1}.footer h2{margin-bottom:15px;font-size:10px}.footer-bottom{margin-top:35px;flex-direction:column;gap:8px}.page{padding:32px 0 55px}.section{padding:50px 0}.section-head h2{font-size:32px}.product-art{height:230px}.login-layout{grid-template-columns:1fr}.login-form-panel{padding:45px 25px 55px}.login-form-panel h1{font-size:40px}.login-image{min-height:370px;padding:35px 25px}.login-image h2{font-size:38px}.collection-copy p{font-size:13px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
</style>
