<%@page pageEncoding="UTF-8" import="java.util.List,java.util.Locale,java.text.NumberFormat,java.time.format.DateTimeFormatter,model.Promotion"%>
<%
    List<Promotion> homeOffers = (List<Promotion>) request.getAttribute("homePromotions");
    NumberFormat homeOfferMoney = NumberFormat.getInstance(new Locale("vi", "VN"));
    if (homeOffers != null && !homeOffers.isEmpty()) {
%>
<div class="offers">
    <% for (Promotion homeOffer : homeOffers) { %>
    <article class="offer">
        <span class="kicker"><%=homeOffer.getMinOrderValue() == null || homeOffer.getMinOrderValue().signum() == 0 ? "Mọi giá trị đơn hàng" : "Đơn từ " + homeOfferMoney.format(homeOffer.getMinOrderValue()) + "₫"%></span>
        <div class="val">−<%=homeOfferMoney.format(homeOffer.getDiscountValue())%><%="Percentage".equals(homeOffer.getDiscountType()) ? "%" : "₫"%></div>
        <h3><%=navEscape(homeOffer.getPromotionName())%></h3>
        <p><% if (homeOffer.getMaxDiscount() != null) { %>Giảm tối đa <%=homeOfferMoney.format(homeOffer.getMaxDiscount())%>₫ · <% } %>đến <%=homeOffer.getEndDate().toLocalDateTime().format(DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%></p>
        <div class="code"><strong><%=navEscape(homeOffer.getPromotionCode())%></strong><button type="button" data-code="<%=navEscape(homeOffer.getPromotionCode())%>">Sao chép</button></div>
        <a href="<%=request.getContextPath()%>/promotions">Xem điều kiện ưu đãi</a>
    </article>
    <% } %>
</div>
<% } else { %>
<div class="offers-empty">
    <p><%=Boolean.TRUE.equals(request.getAttribute("homePromotionsUnavailable")) ? "Chưa tải được ưu đãi. Bạn vui lòng thử lại sau." : "Chưa có khuyến mãi đang diễn ra. Ghé lại để khám phá những ưu đãi mới."%></p>
</div>
<% } %>
