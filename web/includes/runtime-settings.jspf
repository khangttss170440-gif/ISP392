<%-- Only public settings; never expose credentials or the entire configuration object. --%>
<script src="<%=request.getContextPath()%>/assets/app-content.js" defer></script>
<div hidden data-runtime-settings
     data-store-name="<%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%>"
     data-stock-batch="<%=util.AppConfig.integer("INVENTORY_MAX_BATCH_SIZE", 1, 1000)%>"
     data-image-max-count="<%=service.ProductImageStore.MAX_IMAGES%>"
     data-image-recommended-side="<%=util.AppConfig.integer("PRODUCT_IMAGE_RECOMMENDED_SHORT_SIDE", 1, 10000)%>"
     data-locale="<%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_LOCALE"))%>"
     data-timezone="<%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_TIMEZONE"))%>"
     data-cart-max="<%=util.AppConfig.integer("CART_MAX_ITEM_QUANTITY", 1, 1000000)%>"
     data-chat-timeout="<%=util.AppConfig.integer("CHATBOT_CLIENT_TIMEOUT_MILLIS", 1000, 300000)%>"
     data-chat-max="<%=util.AppConfig.integer("CHATBOT_MAX_MESSAGE_LENGTH", 1, 10000)%>"
     data-tracking-poll="<%=util.AppConfig.integer("ORDER_TRACKING_POLL_MILLIS", 1000, 3600000)%>"
     data-tracking-timeout="<%=util.AppConfig.integer("ORDER_TRACKING_REQUEST_TIMEOUT_MILLIS", 1000, 300000)%>"
     data-image-max-bytes="<%=service.ProductImageStore.MAX_FILE_SIZE%>"
     data-image-max-pixels="<%=service.ProductImageStore.MAX_PIXELS%>"
     data-fit-sizes="<%=util.AppConfig.escapeHtml(util.AppConfig.require("FIT_SIZE_LABELS"))%>"
     data-fit-weights="<%=util.AppConfig.escapeHtml(util.AppConfig.require("FIT_WEIGHT_UPPER_KG"))%>"
     data-fit-tall="<%=util.AppConfig.integer("FIT_TALL_HEIGHT_CM", 1, 300)%>"
     data-fit-short="<%=util.AppConfig.integer("FIT_SHORT_HEIGHT_CM", 1, 300)%>"></div>
