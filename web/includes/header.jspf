<%@include file="runtime-settings.jspf"%>
<%@page pageEncoding="UTF-8" import="model.Customer,model.Staff,model.CustomerNotification"%>
<%!
    private String navEscape(Object value) {
        return value == null ? "" : value.toString().replace("&", "&amp;")
                .replace("<", "&lt;").replace(">", "&gt;")
                .replace("\"", "&quot;").replace("'", "&#39;");
    }
%>
<%
    response.setHeader("Cache-Control", "no-store");
    Customer navCustomer = session.getAttribute("customer") instanceof Customer
            ? (Customer) session.getAttribute("customer") : null;
    Object navStaffAccount = session.getAttribute("staff");
    if (!(navStaffAccount instanceof Staff)) navStaffAccount = session.getAttribute("STAFF");
    Staff navStaff = navStaffAccount instanceof Staff ? (Staff) navStaffAccount : null;
    CustomerNotification navNotification = navCustomer != null
            && session.getAttribute("LATEST_CUSTOMER_NOTIFICATION") instanceof CustomerNotification
            ? (CustomerNotification) session.getAttribute("LATEST_CUSTOMER_NOTIFICATION") : null;
    boolean navLoggedIn = navCustomer != null || navStaff != null;
    String navName = navCustomer != null ? navCustomer.getFullName() : navStaff != null ? navStaff.getFullName() : "";
    if (navName == null || navName.trim().isEmpty()) navName = "Tài khoản";
    String navOrders = "/customer/orders";
    String navAccountUrl = "/customer/account.jsp";
    if (navCustomer == null && navStaff != null) {
        navOrders = "Warehouse".equalsIgnoreCase(navStaff.getRole())
                ? "/staff/warehouse/orders" : "/staff/sales/orders";
        navAccountUrl = "Admin".equalsIgnoreCase(navStaff.getRole()) ? "/admin/products" : navOrders;
    }
%>
<%@include file="/includes/store-theme.jspf"%>
<div class="mf-notice" role="region" aria-label="Thông tin mua sắm"><p class="mf-sr">Miễn phí giao hàng cho đơn từ <%=util.AppConfig.escapeHtml(util.AppConfig.money(service.ShippingService.FREE_SHIPPING_THRESHOLD))%>. Thanh toán VNPay hoặc COD. Xem mã ưu đãi tại trang Khuyến mãi.</p><div class="mf-n-track" aria-hidden="true"><div class="mf-n-group"><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Miễn phí giao hàng đơn từ <b>799K</b></span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>Thanh toán <b>VNPay</b> hoặc COD</span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12Z"/><circle cx="7.5" cy="8.5" r="1.3"/></svg><a href="<%=request.getContextPath()%>/promotions" tabindex="-1">Xem <b>mã ưu đãi</b> đang diễn ra</a></span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Miễn phí giao hàng đơn từ <b>799K</b></span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>Thanh toán <b>VNPay</b> hoặc COD</span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12Z"/><circle cx="7.5" cy="8.5" r="1.3"/></svg><a href="<%=request.getContextPath()%>/promotions" tabindex="-1">Xem <b>mã ưu đãi</b> đang diễn ra</a></span></div><div class="mf-n-group"><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Miễn phí giao hàng đơn từ <b>799K</b></span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>Thanh toán <b>VNPay</b> hoặc COD</span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12Z"/><circle cx="7.5" cy="8.5" r="1.3"/></svg><a href="<%=request.getContextPath()%>/promotions" tabindex="-1">Xem <b>mã ưu đãi</b> đang diễn ra</a></span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Miễn phí giao hàng đơn từ <b>799K</b></span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>Thanh toán <b>VNPay</b> hoặc COD</span><span class="mf-n-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12Z"/><circle cx="7.5" cy="8.5" r="1.3"/></svg><a href="<%=request.getContextPath()%>/promotions" tabindex="-1">Xem <b>mã ưu đãi</b> đang diễn ra</a></span></div></div></div>
<header class="topbar"><div class="shell nav">
    <a class="brand" href="<%=request.getContextPath()%>/index.jsp" aria-label="<%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%> — Trang chủ"><%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%></a>
    <nav class="navlinks" aria-label="Điều hướng chính">
        <a href="<%=request.getContextPath()%>/products">Sản phẩm</a>
        <a href="<%=request.getContextPath()%>/index.jsp#look">Phối phụ kiện</a>
        <a href="<%=request.getContextPath()%>/collections" <%=Boolean.TRUE.equals(request.getAttribute("collectionPage"))?"aria-current=\"page\"":""%>>Bộ sưu tập</a>
        <a href="<%=request.getContextPath()%>/promotions">Khuyến mãi</a>
    </nav>
    <div class="nav-actions">
        <% if (navLoggedIn) { %>
        <details class="account-dropdown" id="storeAccountDropdown">
            <summary aria-label="Mở tùy chọn tài khoản" aria-controls="storeAccountPanel">
                <span class="avatar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
                <span class="account-name"><%=navEscape(navName)%></span>
                <svg class="account-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
            </summary>
            <div class="account-panel" id="storeAccountPanel">
                <div class="account-panel-title"><small>CHÀO MỪNG TRỞ LẠI</small><strong><%=navEscape(navName)%></strong></div>
                <a href="<%=request.getContextPath() + navAccountUrl%>"><span>Tài khoản của tôi</span><span aria-hidden="true">↗</span></a>
                <a href="<%=request.getContextPath() + navOrders%>"><span>Đơn hàng</span><span aria-hidden="true">↗</span></a>
                <a href="<%=request.getContextPath()%>/promotions"><span>Khuyến mãi</span><span aria-hidden="true">↗</span></a>
                <form action="<%=request.getContextPath()%>/logout" method="post"><button type="submit"><span>Đăng xuất</span><span aria-hidden="true">↪</span></button></form>
            </div>
        </details>
        <% } else { %>
        <a class="login-link" href="<%=request.getContextPath()%>/login">Đăng nhập <span aria-hidden="true">↗</span></a>
        <% } %>
        <button type="button" class="mf-theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Chuyển sang chế độ tối" title="Chế độ tối"><svg class="mf-ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg><svg class="mf-ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg></button>
        <a class="nav-icon shopping-bag" href="<%=request.getContextPath()%>/cart" aria-label="Giỏ hàng"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg></a>
    </div>
</div></header>
<% if (navNotification != null) { %>
<aside class="customer-notification" role="status" aria-live="polite">
    <div class="customer-notification-mark" aria-hidden="true">!</div>
    <div class="customer-notification-copy">
        <strong><%=navEscape(navNotification.getTitle())%></strong>
        <p><%=navEscape(navNotification.getMessage()).replace("\r\n", "<br>").replace("\n", "<br>")%></p>
        <small>Thông báo mới nhất · <%=navNotification.getCreatedAt()%></small>
    </div>
    <form action="<%=request.getContextPath()%>/customer/notifications/read" method="post">
        <input type="hidden" name="notificationId" value="<%=navNotification.getNotificationID()%>">
        <button class="customer-notification-dismiss" type="submit">Đã đọc</button>
    </form>
</aside>
<% } %>
<script>
(function () {
    var dropdown = document.getElementById('storeAccountDropdown');
    if (!dropdown) return;
    var trigger = dropdown.querySelector('summary');
    trigger.setAttribute('aria-expanded', String(dropdown.open));
    dropdown.addEventListener('toggle', function () { trigger.setAttribute('aria-expanded', String(dropdown.open)); });
    document.addEventListener('click', function (event) { if (!dropdown.contains(event.target)) dropdown.open = false; });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && dropdown.open) { dropdown.open = false; trigger.focus(); }
    });
    dropdown.addEventListener('focusout', function (event) { if (!dropdown.contains(event.relatedTarget)) dropdown.open = false; });
}());
</script>
