<%@page pageEncoding="UTF-8" import="model.Customer,model.Staff"%>
<%!
    private String navEscape(Object value) {
        return value == null ? "" : value.toString().replace("&", "&amp;")
                .replace("<", "&lt;").replace(">", "&gt;")
                .replace("\"", "&quot;").replace("'", "&#39;");
    }
%>
<%
    response.setHeader("Cache-Control", "no-store");
    Customer navCustomer = session.getAttribute("customer") instanceof Customer
            ? (Customer) session.getAttribute("customer") : null;
    Object navStaffAccount = session.getAttribute("staff");
    if (!(navStaffAccount instanceof Staff)) navStaffAccount = session.getAttribute("STAFF");
    Staff navStaff = navStaffAccount instanceof Staff ? (Staff) navStaffAccount : null;
    boolean navLoggedIn = navCustomer != null || navStaff != null;
    String navName = navCustomer != null ? navCustomer.getFullName() : navStaff != null ? navStaff.getFullName() : "";
    if (navName == null || navName.trim().isEmpty()) navName = "Tài khoản";
    String navOrders = "/customer/orders";
    String navAccountUrl = "/customer/account.jsp";
    if (navCustomer == null && navStaff != null) {
        navOrders = "Warehouse".equalsIgnoreCase(navStaff.getRole())
                ? "/staff/warehouse/orders" : "/staff/sales/orders";
        navAccountUrl = "Admin".equalsIgnoreCase(navStaff.getRole()) ? "/admin/products" : navOrders;
    }
%>
<%@include file="/includes/store-theme.jspf"%>
<div class="announcement">MENSFORM &nbsp;—&nbsp; PHONG CÁCH ĐẾN TỪ CHI TIẾT</div>
<header class="topbar"><div class="shell nav">
    <a class="brand" href="<%=request.getContextPath()%>/index.jsp" aria-label="MENSFORM — Trang chủ">MENSFORM<span class="brand-caption">THE MODERN GENTLEMAN</span></a>
    <nav class="navlinks" aria-label="Điều hướng chính">
        <a href="<%=request.getContextPath()%>/index.jsp">Trang chủ</a>
        <a href="<%=request.getContextPath()%>/products">Sản phẩm</a>
        <a href="<%=request.getContextPath()%>/index.jsp#collection">Bộ sưu tập</a>
        <a href="<%=request.getContextPath()%>/promotions">Khuyến mãi</a>
    </nav>
    <div class="nav-actions">
        <% if (navLoggedIn) { %>
        <details class="account-dropdown" id="storeAccountDropdown">
            <summary aria-label="Mở tùy chọn tài khoản" aria-controls="storeAccountPanel">
                <span class="avatar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
                <span class="account-name"><%=navEscape(navName)%></span>
                <svg class="account-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
            </summary>
            <div class="account-panel" id="storeAccountPanel">
                <div class="account-panel-title"><small>CHÀO MỪNG TRỞ LẠI</small><strong><%=navEscape(navName)%></strong></div>
                <a href="<%=request.getContextPath() + navAccountUrl%>"><span>Tài khoản của tôi</span><span aria-hidden="true">↗</span></a>
                <a href="<%=request.getContextPath() + navOrders%>"><span>Đơn hàng</span><span aria-hidden="true">↗</span></a>
                <a href="<%=request.getContextPath()%>/promotions"><span>Khuyến mãi</span><span aria-hidden="true">↗</span></a>
                <form action="<%=request.getContextPath()%>/logout" method="post"><button type="submit"><span>Đăng xuất</span><span aria-hidden="true">↪</span></button></form>
            </div>
        </details>
        <% } else { %>
        <a class="login-link" href="<%=request.getContextPath()%>/login">Đăng nhập <span aria-hidden="true">↗</span></a>
        <% } %>
        <a class="nav-icon shopping-bag" href="<%=request.getContextPath()%>/cart" aria-label="Giỏ hàng"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg></a>
    </div>
</div></header>
<script>
(function () {
    var dropdown = document.getElementById('storeAccountDropdown');
    if (!dropdown) return;
    var trigger = dropdown.querySelector('summary');
    trigger.setAttribute('aria-expanded', String(dropdown.open));
    dropdown.addEventListener('toggle', function () { trigger.setAttribute('aria-expanded', String(dropdown.open)); });
    document.addEventListener('click', function (event) { if (!dropdown.contains(event.target)) dropdown.open = false; });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && dropdown.open) { dropdown.open = false; trigger.focus(); }
    });
    dropdown.addEventListener('focusout', function (event) { if (!dropdown.contains(event.relatedTarget)) dropdown.open = false; });
}());
</script>
