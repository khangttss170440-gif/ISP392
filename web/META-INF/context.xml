<?xml version="1.0" encoding="UTF-8"?>
<!-- NetBeans uses this deployment setting to identify the application's context. -->
<Context path="/MenWearStore">
    <!-- Product photos are kept in the project (product-images\<ProductID>\) and committed with the code.
         A relative value is found beside the deployed app (see ProductImageStore.resolve), so any clone works.
         Use an absolute path here, or the MENSFORM_PRODUCT_IMAGE_DIR environment variable, to point elsewhere. -->
    <Parameter name="productImageDirectory" value="product-images" override="false"/>
</Context>
