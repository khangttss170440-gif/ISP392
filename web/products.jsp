<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.Product,model.ProductCategory"%>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sản phẩm — MENSFORM</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/product-images.css"></head><body>
<%@include file="/includes/header.jspf"%><main class="page"><div class="shell"><div class="breadcrumb"><a href="<%=request.getContextPath()%>/index.jsp">Trang chủ</a>　/　Sản phẩm</div><span class="eyebrow">MENSFORM essentials</span><h1 class="page-title">Danh mục sản phẩm</h1><p class="page-intro">Khám phá những món đồ được chọn lọc cho nhịp sống mỗi ngày.</p>
<div class="catalog-layout"><aside class="filter-box"><h3>Danh mục</h3><a class="filter-link <%=request.getAttribute("categoryId")==null?"active":""%>" href="<%=request.getContextPath()%>/products">Tất cả sản phẩm</a><% List<ProductCategory> categories=(List<ProductCategory>)request.getAttribute("categories"); if(categories!=null) for(ProductCategory category:categories){ boolean selected=request.getAttribute("categoryId")!=null && ((Integer)request.getAttribute("categoryId")).intValue()==category.getCategoryID(); %><a class="filter-link <%=selected?"active":""%>" href="<%=request.getContextPath()%>/products?categoryId=<%=category.getCategoryID()%>"><%=category.getCategoryName()%></a><% } %></aside>
<section><div class="catalog-top"><span><% List<Product> products=(List<Product>)request.getAttribute("productList"); out.print(products==null?0:products.size()); %> sản phẩm</span><span>Mới nhất</span></div><div class="product-grid"><% if(products==null || products.isEmpty()){ %><div class="empty-state"><h3>Chưa có sản phẩm trong danh mục này</h3><p>Hãy quay lại sau hoặc xem các danh mục khác.</p><a class="button small" href="<%=request.getContextPath()%>/products">Xem tất cả</a></div><% } else { for(Product product:products){ %><article class="product-card"><a href="<%=request.getContextPath()%>/product-detail?productId=<%=product.getProductID()%>"><div class="product-art product-photo"><img src="<%=request.getContextPath()%>/product-image?productId=<%=product.getProductID()%>" alt="Ảnh sản phẩm" loading="lazy"><span class="product-tag">MENSFORM EDIT</span><span class="product-stock <%=product.isInStock()?"in-stock":"out-of-stock"%>"><%=product.isInStock()?"Còn hàng":"Hết hàng"%></span></div><div class="product-info"><div class="product-category"><%=product.getCategoryName()==null?"Essential":product.getCategoryName()%></div><h2 class="product-name"><%=product.getProductName()%></h2><p class="product-meta"><%=product.getBrand()==null?"Thiết kế hiện đại":product.getBrand()%><%=product.getMaterial()==null?"":" · "+product.getMaterial()%></p><div class="product-bottom"><span class="text-link">Xem chi tiết</span><span aria-hidden="true">↗</span></div></div></a></article><% }} %></div></section></div></div></main><%@include file="/includes/footer.jspf"%></body></html>
