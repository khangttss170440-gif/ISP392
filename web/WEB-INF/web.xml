<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <!-- Run before authentication filters. Controllers still authorize every
         frame request; the shell does not grant access to protected pages. -->
    <filter>
        <filter-name>singleUrlNavigation</filter-name>
        <filter-class>filter.SingleUrlNavigationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>singleUrlNavigation</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
