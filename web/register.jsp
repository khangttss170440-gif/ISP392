<%@page contentType="text/html" pageEncoding="UTF-8"%><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tạo tài khoản — MENSFORM</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/login-theme.css?v=20261024e"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/register-theme.css?v=20261024e"></head><body class="login-theme register-theme"><%@include file="/includes/header.jspf"%><main class="page"><div class="shell"><div class="auth-wrap"><aside class="auth-aside"><div><span class="eyebrow">Gia nhập MENSFORM</span><h2>Chọn ít hơn.<br>Mặc chất hơn.</h2><p>Tạo tài khoản để bắt đầu hành trình tìm phong cách phù hợp với bạn.</p></div><p>Thông tin của bạn được dùng để hỗ trợ đơn hàng.</p></aside><section class="auth-form"><h1>Tạo tài khoản</h1><p>Mã xác thực sẽ được gửi đến email của bạn.</p><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %><form action="<%=request.getContextPath()%>/register" method="post"><div class="form-grid"><div class="span-2"><label class="form-label" for="fullName">Họ và tên *</label><input class="field" id="fullName" name="fullName" maxlength="150" autocomplete="name" required></div><div class="span-2"><label class="form-label" for="email">Gmail / Email nhận mã *</label><input class="field" id="email" name="email" type="email" maxlength="150" autocomplete="email" required></div><div><label class="form-label" for="phone">Số điện thoại (không bắt buộc)</label><input class="field" id="phone" name="phone" type="tel" maxlength="20" autocomplete="tel"></div><div><label class="form-label" for="dateOfBirth">Ngày sinh</label><input class="field" id="dateOfBirth" name="dateOfBirth" type="date"></div><div><label class="form-label" for="gender">Giới tính</label><select class="select" id="gender" name="gender"><option value="">Chọn</option><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option></select></div><div><label class="form-label" for="password">Mật khẩu *</label><input class="field" id="password" name="password" type="password" minlength="8" autocomplete="new-password" required></div><div><label class="form-label" for="confirmPassword">Nhập lại mật khẩu *</label><input class="field" id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required></div></div><button class="button" style="width:100%;margin-top:22px" type="submit">Gửi mã xác thực ↗</button></form><p style="margin-top:16px">Đã có tài khoản? <a class="text-link" href="<%=request.getContextPath()%>/login"><b>Đăng nhập</b></a></p></section></div></div></main><%@include file="/includes/footer.jspf"%></body></html>

