<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.Locale,java.text.NumberFormat,model.Cart,model.CartItem"%>
<% Cart cart=(Cart)request.getAttribute("cart"); NumberFormat money=NumberFormat.getInstance(new Locale("vi","VN")); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Giỏ hàng — MENSFORM</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><%@include file="/includes/header.jspf"%><main class="page"><div class="shell"><div class="breadcrumb"><a href="<%=request.getContextPath()%>/products">Tiếp tục mua sắm</a>　/　Giỏ hàng</div><span class="eyebrow">Đã chọn là vừa</span><h1 class="page-title">Giỏ hàng của bạn</h1><p class="page-intro">Kiểm tra lại các sản phẩm trước khi đặt hàng.</p>
<% if(request.getAttribute("message")!=null){ %><div class="alert success"><%=request.getAttribute("message")%></div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %>
<% if(cart==null||cart.isEmpty()){ %><div class="empty-state"><h2>Giỏ hàng đang trống</h2><p>Khám phá bộ sưu tập và chọn món đồ bạn yêu thích.</p><a class="button" href="<%=request.getContextPath()%>/products">Khám phá sản phẩm ↗</a></div><% } else { %><div class="cart-layout"><section class="cart-list"><% for(CartItem item:cart.getItems()){ %><article class="cart-item"><a class="cart-thumb" href="<%=request.getContextPath()%>/product-detail?productId=<%=item.getProductID()%>" aria-label="<%=item.getProductName()%>"></a><div><h3><a href="<%=request.getContextPath()%>/product-detail?productId=<%=item.getProductID()%>"><%=item.getProductName()%></a></h3><p><%=item.getBrand()==null?"":item.getBrand()%>　·　<%=item.getColor()%> / <%=item.getSize()%></p><p><%=money.format(item.getUnitPrice())%>₫ / sản phẩm</p><div class="cart-actions"><form class="cart-actions" action="<%=request.getContextPath()%>/cart" method="post"><input type="hidden" name="action" value="update"><input type="hidden" name="variantId" value="<%=item.getVariantID()%>"><input class="qty" type="number" name="quantity" min="1" max="99" value="<%=item.getQuantity()%>" aria-label="Số lượng"><button class="button line small" type="submit">Cập nhật</button></form><form action="<%=request.getContextPath()%>/cart" method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="variantId" value="<%=item.getVariantID()%>"><button class="button line small" type="submit">Xóa</button></form></div></div><div><b><%=money.format(item.getLineTotal())%>₫</b></div></article><% } %><form action="<%=request.getContextPath()%>/cart" method="post" style="margin-top:16px"><input type="hidden" name="action" value="clear"><button class="button line small" type="submit">Xóa toàn bộ giỏ hàng</button></form></section><aside class="summary"><h2>Tóm tắt đơn hàng</h2><div class="summary-row"><span>Tạm tính · <%=cart.getTotalQuantity()%> sản phẩm</span><b><%=money.format(cart.getSubtotal())%>₫</b></div><div class="summary-row"><span>Vận chuyển</span><span>Tính khi đặt hàng</span></div><div class="summary-row total"><span>Tổng cộng</span><span><%=money.format(cart.getSubtotal())%>₫</span></div><a class="button" href="<%=request.getContextPath()%>/checkout">Tiến hành đặt hàng ↗</a><p class="notice">Thanh toán khi nhận hàng · COD</p></aside></div><% } %></div></main><%@include file="/includes/footer.jspf"%></body></html>
