<%@include file="../../includes/runtime-settings.jspf"%>
<%@page pageEncoding="UTF-8"%>
<%
    String sp = request.getServletPath();
    boolean sales = sp != null && sp.contains("/sales/");
    Object so = session.getAttribute("staff");
    if (!(so instanceof model.Staff)) so = session.getAttribute("STAFF");
    model.Staff st = so instanceof model.Staff ? (model.Staff) so : null;
%>
<link rel="stylesheet" href="<%=util.AppConfig.escapeHtml(util.AppConfig.httpsUrl("UI_FONT_STYLESHEET_URL"))%>">
<link rel="stylesheet" href="<%=request.getContextPath()%>/assets/mensform.css?v=20261024e">
<link rel="stylesheet" href="<%=request.getContextPath()%>/assets/mensform-admin.css?v=20261024e">
<link rel="stylesheet" href="<%=request.getContextPath()%>/assets/mensform-dark.css?v=20261024e">
<script src="<%=request.getContextPath()%>/assets/mensform-theme.js?v=20261024e"></script>
<aside class="portal-sidebar">
    <a class="portal-brand" href="<%=request.getContextPath()%><%=sales ? "/staff/sales/orders" : "/staff/warehouse/orders"%>">MENS<i>FORM</i></a>
    <div>
        <div class="portal-caption"><%=sales ? "B&#7896; PH&#7852;N SALES" : "B&#7896; PH&#7852;N KHO"%></div>
        <nav class="portal-nav">
            <% if (sales) { %>
                <a class="portal-link <%=sp.endsWith("/orders") || sp.endsWith("/order-detail") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/sales/orders">&#9638; &#272;&#417;n ch&#7901; duy&#7879;t</a>
                <a class="portal-link <%=sp.contains("order-requests") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/sales/order-requests">&#9672; Y&#234;u c&#7847;u kh&#225;ch</a>
                <a class="portal-link <%=sp.contains("inventory-issues") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/sales/inventory-issues">&#9888; S&#7921; c&#7889; kho</a>
                <a class="portal-link <%=sp.contains("support") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/sales/support">&#9993; H&#7895; tr&#7907;</a>
            <% } else { %>
                <a class="portal-link <%=sp.contains("collection") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/collections">◇ Bộ sưu tập</a>
                <a class="portal-link <%=sp.endsWith("/orders") || sp.endsWith("/order-detail") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/orders">&#9638; &#272;&#417;n xu&#7845;t kho</a>
                <a class="portal-link <%=sp.contains("stocktaking") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/stocktaking">&#9783; Ki&#7875;m k&#234; t&#7891;n kho</a>
                <a class="portal-link <%=sp.contains("inventory-issues") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/inventory-issues">&#9888; B&#225;o c&#225;o s&#7921; c&#7889;</a>
                <a class="portal-link <%=sp.contains("product-form") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/product-form">&#10010; &#272;&#259;ng s&#7843;n ph&#7849;m</a>
                <a class="portal-link <%=sp.contains("product-images") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/product-images">▧ Ảnh sản phẩm</a>
                <a class="portal-link <%=sp.contains("variants") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/variants">&#9671; SKU / Bi&#7871;n th&#7875;</a>
                <a class="portal-link <%=sp.contains("returns") ? "active" : ""%>" href="<%=request.getContextPath()%>/staff/warehouse/returns">&#8634; H&#224;ng tr&#7843; v&#7873;</a>
            <% } %>
        </nav>
    </div>
    <div class="portal-side-bottom"><button type="button" class="mf-theme-toggle mf-theme-toggle--side" data-theme-toggle aria-pressed="false" aria-label="Chuyển sang chế độ tối" title="Chế độ tối"><svg class="mf-ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg><svg class="mf-ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg><span>Giao diện</span></button><%=st == null ? "Nh&#226;n vi&#234;n" : st.getFullName()%><br><a href="<%=request.getContextPath()%>/index.jsp">V&#7873; c&#7917;a h&#224;ng</a></div>
</aside>
