<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,java.text.NumberFormat,java.util.Locale,model.SalesOrder,model.OrderRequest,model.OrderRequestLine"%><% List<SalesOrder> orders = (List<SalesOrder>) request.getAttribute("orders");
    List<OrderRequest> requests = (List<OrderRequest>) request.getAttribute("orderRequests");
    NumberFormat money = NumberFormat.getInstance(new Locale("vi", "VN"));
    boolean req = request.getServletPath().contains("order-requests") || requests != null;%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sales | <%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%></title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><div class="portal-layout"><%@include file="/staff/includes/nav.jspf"%><main class="portal-main"><header class="portal-head"><div><span class="eyebrow">SALES DESK</span><h1><%=req ? "Y&#234;u c&#7847;u t&#7915; kh&#225;ch" : "&#272;&#417;n ch&#7901; x&#225;c nh&#7853;n"%></h1><p>Duy&#7879;t &#273;&#417;n m&#7899;i v&#224; x&#7917; l&#253; y&#234;u c&#7847;u mua h&#224;ng.</p></div></header><% if (request.getAttribute("message") != null) {%><div class="alert success"><%=request.getAttribute("message")%></div><% }
    if (request.getAttribute("error") != null) {%><div class="alert error"><%=request.getAttribute("error")%></div><% }%><nav class="portal-actions" style="margin-bottom:16px"><a class="button <%=req ? "line" : ""%>" href="<%=request.getContextPath()%>/staff/sales/orders">&#272;&#417;n ch&#7901; x&#225;c nh&#7853;n</a><a class="button <%=req ? "" : "line"%>" href="<%=request.getContextPath()%>/staff/sales/order-requests">Y&#234;u c&#7847;u h&#7911;y / tr&#7843; / &#273;&#7893;i</a></nav><% if (req) { %><section class="portal-panel"><h2>Y&#234;u c&#7847;u &#273;ang ch&#7901;</h2><% if (requests == null || requests.isEmpty()) { %><p class="admin-empty">Kh&#244;ng c&#243; y&#234;u c&#7847;u m&#7899;i.</p><% } else {
    for (OrderRequest r : requests) {%><article class="portal-panel"><span class="portal-badge warn"><%=r.getRequestType()%></span><h2>&#272;&#417;n #<%=r.getOrderID()%> &middot; <%=r.getCustomerName()%></h2><p><%=r.getCustomerPhone()%> &middot; <%=r.getRequestedAt()%></p><p><b>L&#253; do:</b> <%=r.getReason()%></p><% if (r.getLines() != null)
        for (OrderRequestLine l : r.getLines()) {%><p><%=l.getProductName()%> &middot; <%=l.getSku()%> &middot; SL <%=l.getQuantity()%></p><% }%><form action="<%=request.getContextPath()%>/staff/sales/order-requests" method="post"><input type="hidden" name="requestId" value="<%=r.getRequestID()%>"><label class="form-label">Ph&#7843;n h&#7891;i cho kh&#225;ch</label><textarea class="field" name="staffResponse" maxlength="1000" rows="2"></textarea><div class="portal-actions"><button class="button" name="action" value="approve">Duy&#7879;t</button><button class="button line" name="action" value="reject">T&#7915; ch&#7889;i</button></div></form></article><% }
    } %></section><% } else { %><section class="portal-panel"><h2>&#272;&#417;n h&#224;ng m&#7899;i</h2><div class="portal-table-wrap"><table class="portal-table"><thead><tr><th>M&#227; &#273;&#417;n</th><th>Kh&#225;ch h&#224;ng</th><th>S&#7843;n ph&#7849;m</th><th>Thanh to&#225;n</th><th>T&#7893;ng</th><th>Thao t&#225;c</th></tr></thead><tbody><% if (orders == null || orders.isEmpty()) { %><tr><td colspan="6" class="admin-empty">Kh&#244;ng c&#243; &#273;&#417;n m&#7899;i.</td></tr><% } else {
    for (SalesOrder o : orders) {%><tr><td><a href="<%=request.getContextPath()%>/staff/sales/order-detail?orderId=<%=o.getOrderID()%>">#<%=o.getOrderID()%></a><div class="portal-muted"><%=o.getOrderDate()%></div></td><td><b><%=o.getCustomerName()%></b><div><%=o.getCustomerPhone()%></div></td><td><%=o.getItemCount()%> m&#243;n</td><td><%=o.getPaymentMethod()%><div class="portal-muted"><%=o.getPaymentStatus()%></div></td><td><b><%=money.format(o.getTotalAmount())%>&#8363;</b></td><td><div class="portal-actions"><form action="<%=request.getContextPath()%>/staff/sales/orders" method="post"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><button class="button small" name="action" value="confirm">X&#225;c nh&#7853;n</button></form><form action="<%=request.getContextPath()%>/staff/sales/orders" method="post"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><input class="field" name="reason" maxlength="500" placeholder="L&#253; do h&#7911;y"><button class="button line small" name="action" value="cancel">H&#7911;y</button></form></div></td></tr><% }
    } %></tbody></table></div></section><% }%></main></div></body></html>