<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.WarehouseIssue"%><% List<WarehouseIssue> issues = (List<WarehouseIssue>) request.getAttribute("issues");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>S&#7921; c&#7889; kho | Sales</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><div class="portal-layout"><%@include file="/staff/includes/nav.jspf"%><main class="portal-main"><header class="portal-head"><div><span class="eyebrow">SALES DESK</span><h1>S&#7921; c&#7889; kho</h1><p>Xem s&#7921; c&#7889; h&#224;ng h&#243;a v&#224; ph&#7843;n h&#7891;i h&#432;&#7899;ng x&#7917; l&#253;.</p></div></header><% if (request.getAttribute("message") != null) {%><div class="alert success"><%=request.getAttribute("message")%></div><% }
    if (request.getAttribute("error") != null) {%><div class="alert error"><%=request.getAttribute("error")%></div><% } %><section class="portal-panel"><% if (issues == null || issues.isEmpty()) { %><p class="admin-empty">Hi&#7879;n kh&#244;ng c&#243; s&#7921; c&#7889; kho &#273;ang m&#7903;.</p><% } else {
    for (WarehouseIssue i : issues) {%><article class="portal-row"><div><span class="portal-badge warn"><%=i.getIssueType()%></span><h3>&#272;&#417;n #<%=i.getOrderID()%> &middot; <%=i.getProductName()%></h3><p>SKU <%=i.getSku()%> &middot; SL <%=i.getQuantity()%> &middot; <%=i.getReportedByName()%></p><p><%=i.getDescription()%></p><small class="portal-muted"><%=i.getCreatedAt()%></small></div><form action="<%=request.getContextPath()%>/staff/sales/inventory-issues" method="post"><input type="hidden" name="issueId" value="<%=i.getIssueID()%>"><label class="form-label">Ghi ch&#250; x&#7917; l&#253;</label><textarea class="field" name="resolutionNote" maxlength="1000" rows="2" required></textarea><div class="portal-actions"><button class="button small" name="action" value="resolve">&#272;&#227; x&#7917; l&#253;</button><button class="button line small" name="action" value="reject">T&#7915; ch&#7889;i</button></div></form></article><% }
    }%></section></main></div></body></html>