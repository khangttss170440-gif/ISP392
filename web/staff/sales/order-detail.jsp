<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,java.text.NumberFormat,java.util.Locale,model.SalesOrder,model.OrderLine"%><% SalesOrder o = (SalesOrder) request.getAttribute("order");
    List<OrderLine> lines = (List<OrderLine>) request.getAttribute("orderLines");
    NumberFormat money = NumberFormat.getInstance(new Locale("vi", "VN"));%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>&#272;&#417;n #<%=o.getOrderID()%> | Sales</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><div class="portal-layout"><%@include file="/staff/includes/nav.jspf"%><main class="portal-main"><a href="<%=request.getContextPath()%>/staff/sales/orders">&#8592; Danh s&#225;ch &#273;&#417;n</a><header class="portal-head"><div><span class="eyebrow">SALES DESK</span><h1>&#272;&#417;n #<%=o.getOrderID()%></h1><p><%=o.getCustomerName()%> &middot; <%=o.getCustomerPhone()%> &middot; <%=o.getOrderDate()%></p></div><span class="portal-badge warn"><%=o.getOrderStatus()%></span></header><section class="portal-panel"><h2>S&#7843;n ph&#7849;m</h2><div class="portal-table-wrap"><table class="portal-table"><thead><tr><th>S&#7843;n ph&#7849;m</th><th>SKU</th><th>SL</th><th>&#272;&#417;n gi&#225;</th><th>Th&#224;nh ti&#7873;n</th></tr></thead><tbody><% if (lines != null)
        for (OrderLine l : lines) {%><tr><td><%=l.getProductName()%> <span class="portal-muted"><%=l.getColor()%> / <%=l.getSize()%></span></td><td><%=l.getSku()%></td><td><%=l.getQuantity()%></td><td><%=money.format(l.getUnitPrice())%>&#8363;</td><td><%=money.format(l.getLineTotal())%>&#8363;</td></tr><% }%></tbody></table></div><p><b>&#272;&#7883;a ch&#7881; giao:</b> <%=o.getShippingAddress()%></p><p><%=o.getPaymentMethod()%> &middot; <%=o.getPaymentStatus()%></p><h3>T&#7893;ng c&#7897;ng: <%=money.format(o.getTotalAmount())%>&#8363;</h3><form action="<%=request.getContextPath()%>/staff/sales/orders" method="post"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><button class="button" name="action" value="confirm">X&#225;c nh&#7853;n &#273;&#417;n</button></form></section></main></div></body></html>