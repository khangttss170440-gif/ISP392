<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.SupportTicket,model.SupportMessage"%><% List<SupportTicket> tickets = (List<SupportTicket>) request.getAttribute("tickets");
    List<SupportMessage> messages = (List<SupportMessage>) request.getAttribute("messages");
    SupportTicket chosen = (SupportTicket) request.getAttribute("selectedTicket");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>H&#7895; tr&#7907; | Sales</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><div class="portal-layout"><%@include file="/staff/includes/nav.jspf"%><main class="portal-main"><header class="portal-head"><div><span class="eyebrow">SALES DESK</span><h1>H&#7895; tr&#7907; kh&#225;ch h&#224;ng</h1><p>Ph&#7843;n h&#7891;i ticket v&#224; c&#7853;p nh&#7853;t t&#236;nh tr&#7841;ng x&#7917; l&#253;.</p></div></header><% if (request.getAttribute("message") != null) {%><div class="alert success"><%=request.getAttribute("message")%></div><% }
    if (request.getAttribute("error") != null) {%><div class="alert error"><%=request.getAttribute("error")%></div><% } %><div class="cart-layout"><section class="portal-panel"><h2>Ticket</h2><% if (tickets != null)
        for (SupportTicket t : tickets) {%><a class="portal-row" href="<%=request.getContextPath()%>/staff/sales/support?ticketId=<%=t.getTicketID()%>"><div><b>#<%=t.getTicketID()%> &middot; <%=t.getSubject()%></b><p><%=t.getCustomerName()%> &middot; <%=t.getUpdatedAt()%></p><small><%=t.getLastMessage()%></small></div><span class="portal-badge"><%=t.getStatus()%></span></a><% }
    if (tickets == null || tickets.isEmpty()) { %><p class="portal-muted">Ch&#432;a c&#243; ticket.</p><% } %></section><section class="portal-panel"><% if (chosen == null) { %><h2>Ch&#7885;n ticket &#273;&#7875; xem</h2><% } else {%><h2>#<%=chosen.getTicketID()%> &middot; <%=chosen.getSubject()%></h2><p><%=chosen.getCustomerName()%> &middot; &#272;&#417;n #<%=chosen.getOrderID()%> &middot; <span class="portal-badge"><%=chosen.getStatus()%></span></p><div class="portal-conversation"><% if (messages != null)
        for (SupportMessage m : messages) {%><article class="portal-message <%="Staff".equalsIgnoreCase(m.getSenderType()) ? "staff" : ""%>"><b><%=m.getSenderName()%></b><p><%=m.getMessageBody()%></p><small><%=m.getCreatedAt()%></small></article><% } %></div><% if (!"Resolved".equalsIgnoreCase(chosen.getStatus()) && !"Closed".equalsIgnoreCase(chosen.getStatus())) {%><form action="<%=request.getContextPath()%>/staff/sales/support" method="post"><input type="hidden" name="ticketId" value="<%=chosen.getTicketID()%>"><label class="form-label">N&#7897;i dung ph&#7843;n h&#7891;i</label><textarea class="field" name="message" maxlength="2000" rows="4" required></textarea><div class="portal-actions"><button class="button" name="action" value="reply">G&#7917;i ph&#7843;n h&#7891;i</button><button class="button line" name="action" value="resolve">&#272;&#243;ng ticket</button></div></form><% } %><% }%></section></div></main></div></body></html>