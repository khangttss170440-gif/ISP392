<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.WarehouseOrder,model.OrderLine"%><% WarehouseOrder o=(WarehouseOrder)request.getAttribute("order"); List<OrderLine> lines=(List<OrderLine>)request.getAttribute("orderLines"); %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>&#272;&#417;n #<%=o.getOrderID()%> | Kho</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><div class="portal-layout"><%@include file="/staff/includes/nav.jspf"%><main class="portal-main"><a href="<%=request.getContextPath()%>/staff/warehouse/orders">&#8592; Danh s&#225;ch &#273;&#417;n kho</a><header class="portal-head" style="margin-top:18px"><div><span class="eyebrow">WAREHOUSE</span><h1>&#272;&#417;n #<%=o.getOrderID()%></h1><p><%=o.getCustomerName()%> &middot; <%=o.getCustomerPhone()%> &middot; <%=o.getOrderDate()%></p></div><span class="portal-badge"><%=o.getOrderStatus()%> / <%=o.getShipmentStatus()%></span></header><% if(request.getAttribute("message")!=null){ %><div class="alert success"><%=request.getAttribute("message")%></div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %><section class="portal-panel"><h2>S&#7843;n ph&#7849;m c&#7847;n so&#7841;n</h2><div class="portal-table-wrap"><table class="portal-table"><thead><tr><th>S&#7843;n ph&#7849;m</th><th>SKU</th><th>M&#224;u / c&#7905;</th><th>S&#7889; l&#432;&#7907;ng</th><th>B&#225;o s&#7921; c&#7889;</th></tr></thead><tbody><% if(lines!=null) for(OrderLine l:lines){ %><tr><td><b><%=l.getProductName()%></b></td><td><%=l.getSku()%></td><td><%=l.getColor()%> / <%=l.getSize()%></td><td><%=l.getQuantity()%></td><td><details><summary>B&#225;o thi&#7871;u / h&#432; h&#7887;ng</summary><form action="<%=request.getContextPath()%>/staff/warehouse/inventory-issues" method="post"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><input type="hidden" name="variantId" value="<%=l.getVariantID()%>"><label class="form-label">S&#7889; l&#432;&#7907;ng</label><input class="field" type="number" name="quantity" min="1" max="<%=l.getQuantity()%>" required><label class="form-label">Lo&#7841;i s&#7921; c&#7889;</label><select class="select" name="issueType"><option value="Missing">Thi&#7871;u h&#224;ng</option><option value="Damaged">H&#432; h&#7887;ng</option><option value="Other">Kh&#225;c</option></select><label class="form-label">M&#244; t&#7843;</label><textarea class="field" name="description" maxlength="1000" required></textarea><button class="button small">G&#7917;i b&#225;o c&#225;o</button></form></details></td></tr><% } %></tbody></table></div><p><b>&#272;&#7883;a ch&#7881;:</b> <%=o.getShippingAddress()%></p></section><%@include file="/staff/warehouse/ghn-panel.jspf"%><% if(ghn == null || "Ready".equals(ghn.get("BookingState")) || "Booked".equals(ghn.get("BookingState"))){ %><section class="portal-panel"><h2>M&#244; ph&#7887;ng v&#7853;n chuy&#7875;n</h2><p>C&#225;c thao t&#225;c n&#224;y gi&#7843; l&#7853;p &#273;&#417;n v&#7883; v&#7853;n chuy&#7875;n &#273;&#227; l&#7845;y h&#224;ng ho&#7863;c giao th&#224;nh c&#244;ng; kh&#244;ng g&#7885;i h&#227;ng v&#7853;n chuy&#7875;n th&#7853;t.</p><% if("Confirmed".equalsIgnoreCase(o.getOrderStatus())){ %><form action="<%=request.getContextPath()%>/staff/warehouse/orders" method="post"><input type="hidden" name="csrfToken" value="<%=ghnEscape(request.getAttribute("ghnCsrf"))%>"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><input type="hidden" name="action" value="simulatePickup"><button class="button">M&#244; ph&#7887;ng &#273;&#417;n v&#7883; v&#7853;n chuy&#7875;n &#273;&#227; l&#7845;y h&#224;ng</button></form><% }else if("Shipped".equalsIgnoreCase(o.getOrderStatus())){ %><form action="<%=request.getContextPath()%>/staff/warehouse/orders" method="post"><input type="hidden" name="csrfToken" value="<%=ghnEscape(request.getAttribute("ghnCsrf"))%>"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><input type="hidden" name="action" value="simulateDelivery"><button class="button">M&#244; ph&#7887;ng giao h&#224;ng th&#224;nh c&#244;ng</button></form><% }else{ %><p>&#272;&#417;n &#273;&#227; giao xong.</p><% } %></section><% if(ghn == null || "Ready".equals(ghn.get("BookingState"))){ %><section class="portal-panel"><h2>C&#7853;p nh&#7853;t v&#7853;n chuy&#7875;n th&#7911; c&#244;ng</h2><% if("Confirmed".equalsIgnoreCase(o.getOrderStatus())){ %><form action="<%=request.getContextPath()%>/staff/warehouse/orders" method="post" class="portal-form-grid"><input type="hidden" name="csrfToken" value="<%=ghnEscape(request.getAttribute("ghnCsrf"))%>"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><input type="hidden" name="action" value="ship"><div><label class="form-label">H&#227;ng v&#7853;n chuy&#7875;n *</label><input class="field" name="carrier" maxlength="100" required></div><div><label class="form-label">M&#227; v&#7853;n &#273;&#417;n</label><input class="field" name="trackingNumber" maxlength="100"></div><div class="span-all"><button class="button">X&#225;c nh&#7853;n &#273;&#227; giao cho &#273;&#417;n v&#7883; v&#7853;n chuy&#7875;n</button></div></form><% }else if("Shipped".equalsIgnoreCase(o.getOrderStatus())){ %><form action="<%=request.getContextPath()%>/staff/warehouse/orders" method="post"><input type="hidden" name="csrfToken" value="<%=ghnEscape(request.getAttribute("ghnCsrf"))%>"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><input type="hidden" name="action" value="deliver"><button class="button">X&#225;c nh&#7853;n &#273;&#227; giao</button></form><p><%=o.getCarrier()%> &middot; <%=o.getTrackingNumber()%></p><% }else{ %><p>&#272;&#417;n &#273;&#227; giao xong.</p><% } %></section><% } %><% } %></main></div></body></html>