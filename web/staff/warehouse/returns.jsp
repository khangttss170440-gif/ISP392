<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.OrderRequest,model.OrderRequestLine"%><% List<OrderRequest> returns=(List<OrderRequest>)request.getAttribute("approvedReturns"); %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>H&#224;ng tr&#7843; v&#7873; | Kho</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><div class="portal-layout"><%@include file="/staff/includes/nav.jspf"%><main class="portal-main"><header class="portal-head"><div><span class="eyebrow">WAREHOUSE</span><h1>Ti&#7871;p nh&#7853;n h&#224;ng tr&#7843;</h1><p>Ghi s&#7889; l&#432;&#7907;ng nh&#7853;n v&#7873; v&#224; s&#7889; l&#432;&#7907;ng &#273;&#7841;t ch&#7845;t l&#432;&#7907;ng &#273;&#7875; nh&#7853;p kho.</p></div></header><% if(request.getAttribute("message")!=null){ %><div class="alert success"><%=request.getAttribute("message")%></div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %><% if(returns==null||returns.isEmpty()){ %><section class="portal-panel admin-empty">Kh&#244;ng c&#243; y&#234;u c&#7847;u tr&#7843; h&#224;ng &#273;&#227; duy&#7879;t.</section><% }else{ for(OrderRequest r:returns){ %><section class="portal-panel"><div class="portal-head"><div><span class="portal-badge warn">&#272;&#227; duy&#7879;t</span><h2>Y&#234;u c&#7847;u #<%=r.getRequestID()%> &middot; &#272;&#417;n #<%=r.getOrderID()%></h2><p><%=r.getCustomerName()%> &middot; <%=r.getCustomerPhone()%> &middot; <%=r.getRequestedAt()%></p></div></div><p><%=r.getReason()%></p><form action="<%=request.getContextPath()%>/staff/warehouse/returns" method="post"><input type="hidden" name="requestId" value="<%=r.getRequestID()%>"><div class="portal-table-wrap"><table class="portal-table"><thead><tr><th>S&#7843;n ph&#7849;m</th><th>SKU</th><th>SL &#273;&#7873; ngh&#7883;</th><th>SL nh&#7853;n</th><th>SL nh&#7853;p kho</th></tr></thead><tbody><% if(r.getLines()!=null) for(OrderRequestLine l:r.getLines()){ %><tr><td><%=l.getProductName()%> <span class="portal-muted"><%=l.getColor()%> / <%=l.getSize()%></span><input type="hidden" name="orderDetailId" value="<%=l.getOrderDetailID()%>"></td><td><%=l.getSku()%></td><td><%=l.getQuantity()%></td><td><input class="field" type="number" name="receivedQuantity" min="0" max="<%=l.getQuantity()%>" value="<%=l.getQuantity()%>" required></td><td><input class="field" type="number" name="acceptedQuantity" min="0" max="<%=l.getQuantity()%>" value="<%=l.getQuantity()%>" required></td></tr><% } %></tbody></table></div><label class="form-label">Ghi ch&#250; kho</label><textarea class="field" name="warehouseNote" maxlength="1000" rows="2"></textarea><button class="button" type="submit">X&#225;c nh&#7853;n ti&#7871;p nh&#7853;n</button></form><p class="portal-muted">S&#7889; l&#432;&#7907;ng nh&#7853;p kho kh&#244;ng &#273;&#432;&#7907;c v&#432;&#7907;t s&#7889; l&#432;&#7907;ng nh&#7853;n.</p></section><% }} %></main></div></body></html>