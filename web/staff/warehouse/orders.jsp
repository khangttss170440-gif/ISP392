<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.WarehouseOrder"%><% List<WarehouseOrder> orders=(List<WarehouseOrder>)request.getAttribute("orders"); %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>&#272;&#417;n kho | <%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%></title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><div class="portal-layout"><%@include file="/staff/includes/nav.jspf"%><main class="portal-main"><header class="portal-head"><div><span class="eyebrow">WAREHOUSE</span><h1>&#272;&#417;n xu&#7845;t kho</h1><p>Chu&#7849;n b&#7883; &#273;&#417;n &#273;&#227; &#273;&#432;&#7907;c Sales x&#225;c nh&#7853;n v&#224; theo d&#245;i v&#7853;n chuy&#7875;n.</p></div></header><% if(request.getAttribute("message")!=null){ %><div class="alert success"><%=request.getAttribute("message")%></div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %><section class="portal-panel"><div class="portal-table-wrap"><table class="portal-table"><thead><tr><th>&#272;&#417;n</th><th>Kh&#225;ch h&#224;ng</th><th>&#272;&#7883;a ch&#7881;</th><th>Giao h&#224;ng</th><th>Thao t&#225;c</th></tr></thead><tbody><% if(orders==null||orders.isEmpty()){ %><tr><td colspan="5" class="admin-empty">Kh&#244;ng c&#243; &#273;&#417;n c&#7847;n x&#7917; l&#253;.</td></tr><% }else{ for(WarehouseOrder o:orders){ %><tr><td><a href="<%=request.getContextPath()%>/staff/warehouse/order-detail?orderId=<%=o.getOrderID()%>">#<%=o.getOrderID()%></a><div class="portal-muted"><%=o.getOrderDate()%></div><span class="portal-badge"><%=o.getOrderStatus()%></span></td><td><b><%=o.getCustomerName()%></b><div><%=o.getCustomerPhone()%></div></td><td><%=o.getShippingAddress()%></td><td><%=o.getShipmentStatus()%><div class="portal-muted"><%=o.getCarrier()==null?"":o.getCarrier()%> <%=o.getTrackingNumber()==null?"":o.getTrackingNumber()%></div></td><td><a class="button line small" href="<%=request.getContextPath()%>/staff/warehouse/order-detail?orderId=<%=o.getOrderID()%>">M&#7903; chi ti&#7871;t</a></td></tr><% }} %></tbody></table></div></section></main></div></body></html>