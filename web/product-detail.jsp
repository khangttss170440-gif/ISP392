<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,java.util.Locale,java.text.NumberFormat,java.math.BigDecimal,model.Product,model.ProductVariant,model.ProductReview"%>
<% Product product=(Product)request.getAttribute("product"); List<ProductVariant> variants=(List<ProductVariant>)request.getAttribute("variants"); List<ProductReview> reviews=(List<ProductReview>)request.getAttribute("reviews"); NumberFormat money=NumberFormat.getInstance(new Locale("vi","VN")); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=product.getProductName()%> — MENSFORM</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><%@include file="/includes/header.jspf"%>
<main class="page"><div class="shell"><div class="breadcrumb"><a href="<%=request.getContextPath()%>/products">Sản phẩm</a>　/　<%=product.getCategoryName()%>　/　<%=product.getProductName()%></div><div class="detail-layout"><div class="detail-art" role="img" aria-label="<%=product.getProductName()%>"></div><div class="detail-copy"><span class="eyebrow"><%=product.getBrand()==null?"MENSFORM":product.getBrand()%></span><h1><%=product.getProductName()%></h1><p><%=product.getDescription()==null?"Một lựa chọn tinh giản, dễ kết hợp và phù hợp cho nhịp sống hằng ngày.":product.getDescription()%></p><div class="detail-price" id="selected-price">Chọn màu và kích cỡ</div><p><%=product.getMaterial()==null?"":("Chất liệu · "+product.getMaterial())%></p>
<% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %><form action="<%=request.getContextPath()%>/cart" method="post"><input type="hidden" name="action" value="add"><label class="form-label" for="variantId">Màu sắc · Kích cỡ</label><select class="select" id="variantId" name="variantId" required onchange="showVariantPrice(this)"><option value="">Chọn phiên bản</option><% if(variants!=null) for(ProductVariant variant:variants){ %><option value="<%=variant.getVariantID()%>" data-price="<%=money.format(variant.getPrice())%>" <%=variant.getQuantity()<=0?"disabled":""%>><%=variant.getColor()%> · <%=variant.getSize()%> — <%=variant.getQuantity()>0?"Còn "+variant.getQuantity()+" sản phẩm":"Hết hàng"%></option><% } %></select><div class="inline-form"><div class="grow"><label class="form-label" for="quantity">Số lượng</label><input class="field" id="quantity" name="quantity" type="number" min="1" max="99" value="1" required></div><button class="button" type="submit" <%=variants==null||variants.isEmpty()?"disabled":""%>>Thêm vào giỏ　↗</button></div></form><p class="product-meta" style="margin-top:15px">Miễn phí vận chuyển từ 799.000₫ · Thanh toán khi nhận hàng</p></div></div>
<section class="section"><div class="section-head"><div><span class="eyebrow">Khách hàng chia sẻ</span><h2>Đánh giá sản phẩm</h2></div><div class="stars">★ <%=request.getAttribute("averageRating")==null?"—":request.getAttribute("averageRating")%> / 5</div></div><div class="review-list"><% if(reviews==null||reviews.isEmpty()){ %><div class="review"><p>Chưa có đánh giá cho sản phẩm này. Hãy là người đầu tiên chia sẻ cảm nhận của bạn.</p></div><% } else { for(ProductReview review:reviews){ %><article class="review"><div class="stars"><%="★".repeat(Math.max(0,review.getRating()))%><%="☆".repeat(Math.max(0,5-review.getRating()))%></div><b><%=review.getCustomerName()==null?"Khách hàng MENSFORM":review.getCustomerName()%></b><p><%=review.getComment()==null?"":review.getComment()%></p></article><% }} %></div></section>
</div></main><%@include file="/includes/footer.jspf"%><script>function showVariantPrice(el){const o=el.options[el.selectedIndex];document.getElementById('selected-price').textContent=o.dataset.price?o.dataset.price+'₫':'Chọn màu và kích cỡ';}</script></body></html>
