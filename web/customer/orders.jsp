<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,java.text.NumberFormat,java.util.Locale,model.CustomerOrder"%><% List<CustomerOrder> orders = (List<CustomerOrder>) request.getAttribute("orders");
    NumberFormat money = NumberFormat.getInstance(new Locale("vi", "VN"));%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>&#272;&#417;n h&#224;ng c&#7911;a t&#244;i | MENSFORM</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><%@include file="/includes/header.jspf"%><main class="shell page"><div class="portal-head"><div><span class="eyebrow">T&#192;I KHO&#7842;N</span><h1 class="page-title">&#272;&#417;n h&#224;ng c&#7911;a t&#244;i</h1><p>Theo d&#245;i tr&#7841;ng th&#225;i giao h&#224;ng v&#224; y&#234;u c&#7847;u sau mua.</p></div><a class="button line" href="<%=request.getContextPath()%>/products">Ti&#7871;p t&#7909;c mua s&#7855;m</a></div><% if (request.getAttribute("error") != null) {%><div class="alert error"><%=request.getAttribute("error")%></div><% }
    if ("1".equals(request.getParameter("requestSent"))) { %><div class="alert success">Y&#234;u c&#7847;u c&#7911;a b&#7841;n &#273;&#227; &#273;&#432;&#7907;c g&#7917;i.</div><% } %><section class="portal-panel"><% if (orders == null || orders.isEmpty()) {%><div class="empty-state"><h2>B&#7841;n ch&#432;a c&#243; &#273;&#417;n h&#224;ng</h2><a class="button" href="<%=request.getContextPath()%>/products">Mua s&#7855;m</a></div><% } else {
    for (CustomerOrder o : orders) {
        String status = o.getOrderStatus() == null ? "" : o.getOrderStatus();%><article class="portal-row"><div><span class="eyebrow">&#272;&#416;N #<%=o.getOrderID()%></span><p><%=o.getOrderDate()%></p><span class="portal-badge <%="Cancelled".equalsIgnoreCase(status) ? "off" : ""%>"><%=status%></span> <%=o.getShipmentStatus() == null ? "" : " &middot; " + o.getShipmentStatus()%></div><div><small class="portal-muted">T&#7893;ng thanh to&#225;n</small><h3><%=money.format(o.getTotalAmount())%>&#8363;</h3></div><div class="portal-actions"><a class="button line small" href="<%=request.getContextPath()%>/customer/order-detail?orderId=<%=o.getOrderID()%>">Chi ti&#7871;t</a><% if ("Pending".equalsIgnoreCase(status) || "Confirmed".equalsIgnoreCase(status) || "Delivered".equalsIgnoreCase(status)) {%><a class="button line small" href="<%=request.getContextPath()%>/customer/order-request?orderId=<%=o.getOrderID()%>">G&#7917;i y&#234;u c&#7847;u</a><% } %></div></article><% }
    }%></section></main><%@include file="/includes/footer.jspf"%></body></html>