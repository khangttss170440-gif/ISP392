<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.CustomerOrder,model.RequestableOrderLine"%><% CustomerOrder o = (CustomerOrder) request.getAttribute("order");
    List<RequestableOrderLine> lines = (List<RequestableOrderLine>) request.getAttribute("requestableLines");
    boolean canCancel = Boolean.TRUE.equals(request.getAttribute("canRequestCancellation"));
    boolean canReturn = Boolean.TRUE.equals(request.getAttribute("canRequestReturnOrExchange"));%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Y&#234;u c&#7847;u &#273;&#417;n h&#224;ng | <%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%></title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><%@include file="/includes/header.jspf"%><main class="shell page"><a href="<%=request.getContextPath()%>/customer/order-detail?orderId=<%=o.getOrderID()%>">&#8592; &#272;&#417;n #<%=o.getOrderID()%></a><h1 class="page-title">G&#7917;i y&#234;u c&#7847;u</h1><% if (request.getAttribute("error") != null) {%><div class="alert error"><%=request.getAttribute("error")%></div><% } %><% if (canCancel) {%><section class="portal-panel"><h2>Y&#234;u c&#7847;u h&#7911;y &#273;&#417;n</h2><form action="<%=request.getContextPath()%>/customer/order-request" method="post"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><input type="hidden" name="requestType" value="CANCEL"><label class="form-label">L&#253; do *</label><textarea class="field" name="reason" maxlength="1000" required></textarea><button class="button">G&#7917;i y&#234;u c&#7847;u h&#7911;y</button></form></section><% } %><% if (canReturn) {%><section class="portal-panel"><h2>Tr&#7843; h&#224;ng / &#273;&#7893;i h&#224;ng</h2><form action="<%=request.getContextPath()%>/customer/order-request" method="post"><input type="hidden" name="orderId" value="<%=o.getOrderID()%>"><label class="form-label">Lo&#7841;i y&#234;u c&#7847;u</label><select class="select" name="requestType"><option value="RETURN">Tr&#7843; h&#224;ng</option><option value="EXCHANGE">&#272;&#7893;i h&#224;ng</option></select><label class="form-label">L&#253; do *</label><textarea class="field" name="reason" maxlength="1000" required></textarea><h3>Ch&#7885;n s&#7843;n ph&#7849;m v&#224; s&#7889; l&#432;&#7907;ng</h3><% if (lines != null)
        for (RequestableOrderLine l : lines) {%><div class="portal-row"><label><input type="checkbox" class="return-line-check" checked><b><%=l.getProductName()%></b><small class="portal-muted"> <%=l.getSku()%> &middot; C&#242;n l&#7841;i <%=l.getAvailableQuantity()%></small></label><input class="field return-line-qty" type="number" name="quantity" min="1" max="<%=l.getAvailableQuantity()%>" value="1"><input class="return-line-id" type="hidden" name="orderDetailId" value="<%=l.getOrderDetailID()%>"></div><% } %><button class="button" type="submit">G&#7917;i y&#234;u c&#7847;u</button></form></section><script>document.querySelectorAll('.return-line-check').forEach(function(c){var row = c.closest('.portal-row'), q = row.querySelector('.return-line-qty'), id = row.querySelector('.return-line-id'); function sync(){q.disabled = id.disabled = !c.checked}c.addEventListener('change', sync); sync()});</script><% }%></main><%@include file="/includes/footer.jspf"%></body></html>