.getDistrict() == null ? "" : a.getDistrict()%>"></div><div><label class="form-label">T&#7881;nh / th&#224;nh ph&#7889; *</label><input class="field" name="province" maxlength="100" required value="<%=a.getProvince() == null ? "" : a.getProvince()%>"></div><label><input type="checkbox" name="isDefault" value="true" <%=a.isDefaultAddress() ? "checked" : ""%>> &#272;&#7863;t l&#224;m m&#7863;c &#273;&#7883;nh</label><div class="span-all portal-actions"><button class="button" type="submit">L&#432;u &#273;&#7883;a ch&#7881;</button><a class="button line" href="<%=request.getContextPath()%>/customer/addresses">H&#7911;y</a></div></form></section></main><%@include file="/includes/footer.jspf"%></body></html>
