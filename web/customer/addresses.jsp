<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List,model.CustomerAddress"%><% List<CustomerAddress> addresses = (List<CustomerAddress>) request.getAttribute("addresses");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>S&#7893; &#273;&#7883;a ch&#7881; | <%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%></title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css"></head><body><%@include file="/includes/header.jspf"%><main class="shell page"><div class="portal-head"><div><span class="eyebrow">T&#192;I KHO&#7842;N</span><h1 class="page-title">S&#7893; &#273;&#7883;a ch&#7881;</h1><p>Qu&#7843;n l&#253; &#273;&#7883;a ch&#7881; giao h&#224;ng.</p></div><a class="button" href="<%=request.getContextPath()%>/customer/address-form">+ Th&#234;m &#273;&#7883;a ch&#7881;</a></div><% if (request.getAttribute("message") != null) {%><div class="alert success"><%=request.getAttribute("message")%></div><% }
    if (request.getAttribute("error") != null) {%><div class="alert error"><%=request.getAttribute("error")%></div><% } %><section class="portal-panel"><% if (addresses == null || addresses.isEmpty()) { %><div class="empty-state"><h2>Ch&#432;a c&#243; &#273;&#7883;a ch&#7881;</h2><p>Th&#234;m &#273;&#7883;a ch&#7881; &#273;&#7875; &#273;&#7863;t h&#224;ng nhanh h&#417;n.</p></div><% } else {
    for (CustomerAddress a : addresses) {%><article class="portal-row"><div><b><%=a.getRecipientName()%></b> <span class="portal-muted"><%=a.getPhone() == null ? "" : a.getPhone()%></span><p><%=a.getAddressLine()%>, <%=a.getWard() == null ? "" : a.getWard()%>, <%=a.getDistrict() == null ? "" : a.getDistrict()%>, <%=a.getProvince() == null ? "" : a.getProvince()%></p><% if (a.isDefaultAddress()) { %><span class="portal-badge">M&#7863;c &#273;&#7883;nh</span><% }%></div><div class="portal-actions"><a class="button line small" href="<%=request.getContextPath()%>/customer/address-form?id=<%=a.getAddressID()%>">S&#7917;a</a><% if (!a.isDefaultAddress()) {%><form action="<%=request.getContextPath()%>/customer/addresses" method="post"><input type="hidden" name="addressId" value="<%=a.getAddressID()%>"><input type="hidden" name="action" value="default"><button class="button line small">&#272;&#7863;t m&#7863;c &#273;&#7883;nh</button></form><% }%><form action="<%=request.getContextPath()%>/customer/addresses" method="post" onsubmit="return confirm('Xoa dia chi nay?')"><input type="hidden" name="addressId" value="<%=a.getAddressID()%>"><input type="hidden" name="action" value="delete"><button class="button line small">X&#243;a</button></form></div></article><% }
    }%></section></main><%@include file="/includes/footer.jspf"%></body></html>
