<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Tài khoản · <%=util.AppConfig.escapeHtml(util.AppConfig.require("APP_NAME"))%> Admin</title>
        <link rel="stylesheet" href="<%=request.getContextPath()%>/assets/store.css">
    </head>
    <body><div class="admin-layout"><%@include file="/admin/includes/sidebar.jspf"%><main class="admin-main">
        <%@page import="java.util.List,java.time.format.DateTimeFormatter,model.UserAccount,model.Staff"%><% List<UserAccount> accounts=(List<UserAccount>)request.getAttribute("accounts"); String keyword=(String)request.getAttribute("keyword"); String accountType=(String)request.getAttribute("accountType"); Object staffValue=session.getAttribute("staff"); if(!(staffValue instanceof Staff)) staffValue=session.getAttribute("STAFF"); Staff currentAdmin=staffValue instanceof Staff?(Staff)staffValue:null; %>
        <div class="admin-topline"><div><small>ACCESS / ACCOUNTS</small><h1 class="admin-title">Tài khoản & phân quyền</h1></div><span class="admin-note">Nhân viên · Admin · Khách hàng</span></div><p class="admin-subtitle">Cập nhật vai trò và trạng thái tài khoản. Tài khoản hiện tại không thể tự hạ quyền hoặc vô hiệu hóa.</p>
        <% if(request.getAttribute("message")!=null){ %><div class="alert success"><%=request.getAttribute("message")%></div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %>
        <section class="admin-panel"><div class="admin-toolbar"><h2>Tạo tài khoản nhân viên</h2><span class="admin-note">Tài khoản được tạo ở trạng thái Active</span></div><form action="<%=request.getContextPath()%>/admin/users" method="post"><input type="hidden" name="action" value="createStaff"><div class="form-grid"><div><label class="form-label" for="staffFullName">Họ và tên *</label><input class="field" id="staffFullName" name="fullName" maxlength="150" required></div><div><label class="form-label" for="staffEmail">Email *</label><input class="field" id="staffEmail" name="email" type="email" maxlength="150" required></div><div><label class="form-label" for="staffPhone">Số điện thoại</label><input class="field" id="staffPhone" name="phone" type="tel" maxlength="20" pattern="[0-9+(). -]{8,20}"></div><div><label class="form-label" for="staffRole">Vai trò *</label><select class="select" id="staffRole" name="role" required><option value="Sales">Sales</option><option value="Warehouse">Warehouse</option></select></div><div><label class="form-label" for="staffPassword">Mật khẩu tạm *</label><input class="field" id="staffPassword" name="password" type="password" minlength="8" autocomplete="new-password" required></div><div><label class="form-label" for="staffConfirmPassword">Xác nhận mật khẩu *</label><input class="field" id="staffConfirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required></div></div><button class="button small" style="margin-top:16px" type="submit">Tạo tài khoản Staff</button></form></section>
        <section class="admin-panel"><form class="admin-filter" action="<%=request.getContextPath()%>/admin/users" method="get"><input class="field" name="keyword" value="<%=keyword==null?"":keyword%>" placeholder="Tìm tên, email hoặc số điện thoại"><select class="select" name="accountType"><option value="ALL" <%="ALL".equalsIgnoreCase(accountType)?"selected":""%>>Tất cả tài khoản</option><option value="Customer" <%="Customer".equalsIgnoreCase(accountType)?"selected":""%>>Khách hàng</option><option value="Staff" <%="Staff".equalsIgnoreCase(accountType)?"selected":""%>>Nhân viên</option></select><button class="button small" type="submit">Tìm kiếm</button></form></section>
        <section class="admin-panel"><div class="admin-toolbar"><h2>Danh sách tài khoản</h2><span class="admin-note">Tối đa 500 kết quả</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Tài khoản</th><th>Loại</th><th>Vai trò</th><th>Trạng thái</th><th>Tạo lúc</th><th>Cập nhật</th></tr></thead><tbody><% if(accounts==null||accounts.isEmpty()){ %><tr><td colspan="6" class="admin-empty">Không tìm thấy tài khoản phù hợp.</td></tr><% } else { for(UserAccount account:accounts){ String formId="account-"+account.getAccountType()+"-"+account.getAccountID(); boolean self="Staff".equalsIgnoreCase(account.getAccountType())&&currentAdmin!=null&&currentAdmin.getStaffID()==account.getAccountID(); %><tr><td><b><%=account.getFullName()%></b><div class="admin-note"><%=account.getEmail()%><%=account.getPhone()==null?"":" · "+account.getPhone()%></div></td><td><%=account.getAccountType()%> #<%=account.getAccountID()%></td><td><% if("Staff".equalsIgnoreCase(account.getAccountType())&&!self){ %><select form="<%=formId%>" class="select" name="role"><option value="Sales" <%="Sales".equalsIgnoreCase(account.getRole())?"selected":""%>>Sales</option><option value="Warehouse" <%="Warehouse".equalsIgnoreCase(account.getRole())?"selected":""%>>Warehouse</option><option value="Admin" <%="Admin".equalsIgnoreCase(account.getRole())?"selected":""%>>Admin</option></select><% } else { %><%=account.getRole()==null?(self?"Admin đang đăng nhập":"Khách hàng"):account.getRole()%><% } %></td><td><% if(!self){ %><select form="<%=formId%>" class="select" name="status"><option value="Active" <%="Active".equalsIgnoreCase(account.getStatus())?"selected":""%>>Active</option><option value="Inactive" <%="Inactive".equalsIgnoreCase(account.getStatus())?"selected":""%>>Inactive</option></select><% } else { %><span class="admin-badge">Admin hiện tại</span><% } %></td><td><%=account.getCreatedAt()==null?"—":account.getCreatedAt()%></td><td><% if(!self){ %><form id="<%=formId%>" action="<%=request.getContextPath()%>/admin/users" method="post"><input type="hidden" name="accountId" value="<%=account.getAccountID()%>"><input type="hidden" name="accountType" value="<%=account.getAccountType()%>"></form><button form="<%=formId%>" class="button small" type="submit">Lưu</button><% } else { %><span class="admin-note">Không chỉnh sửa</span><% } %></td></tr><% }} %></tbody></table></div></section>
    </main></div>
    </body>
</html>
